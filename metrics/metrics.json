      "base_sql": "(SUM(yards_gained) + (20 * SUM(pass_touchdown)) - (45 * SUM(interception))) / NULLIF(COUNT(*), 0)",
      "rate_only": true,
      "help": "Adjusted net yards per attempt: passing yards (net of sack yardage) plus 20 per TD, minus 45 per INT, divided by dropbacks (every pass play including sacks). Higher is better.",
